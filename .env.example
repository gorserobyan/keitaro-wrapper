# Keitaro Admin API
KEITARO_URL=https://keitaro-for-tests.etolegko.com
KEITARO_API_KEY=put-your-api-key-here

# Defaults applied to every campaign created by the wrapper
# (domain / campaign group / traffic source that exist on the test stand)
KEITARO_DOMAIN_ID=1813
KEITARO_GROUP_ID=10332
KEITARO_TRAFFIC_SOURCE_ID=836

# Where flow #1 sends visitors from the chosen country
GEO_REDIRECT_URL=https://google.com

# SQLAlchemy URL. SQLite for local runs, Postgres in docker-compose.
DATABASE_URL=sqlite:///./keitaro_wrapper.db
